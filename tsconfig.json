{
	"extends": "@tsconfig/node24/tsconfig.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": [
		"vite.config.ts",
		"BackEnd/**/*.ts",
		"BackEndTest/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
