{
  "name": "professor-go",
  "description": "Professor-Go: a hackathon game for recruiting and battling university professors",
  "homepage": "https://github.com/Professor-GO/Main",
  "author": "Reid Holmes",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">= 24 < 25"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "express": "5.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tsconfig/node24": "24.0.1",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "scripts": {
    "start": "node src/server/bootstrap/server.ts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build",
    "build:lint": "npm run build && npm run lint:check",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "test:client": "node --test \"src/client/**/*.test.ts\" && vitest run",
    "build:client": "vite build",
    "test": "npm run test:server && npm run test:client && npm run test:tooling",
    "test:server": "node --test --test-concurrency=1 \"src/server/**/*.test.ts\"",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "test:auth": "node --test src/server/tests/auth.test.ts",
    "account:status": "node src/server/modules/accounts/infrastructure/accountStatus.ts",
    "lint:check": "eslint src/server src/client scripts *.config.ts",
    "lint:fix": "eslint src/server src/client scripts *.config.ts --fix",
    "prettier:check": "prettier \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"*.{json,mjs,ts}\" --check",
    "prettier:fix": "prettier \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"*.{json,mjs,ts}\" --write"
  }
}
