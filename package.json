{
	"name": "professor-go",
	"description": "Professor-Go: a hackathon game for recruiting and battling university professors",
	"homepage": "https://github.com/Professor-GO/Main",
	"author": "Reid Holmes",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"engines": {
		"node": ">= 24 < 25"
	},
	"dependencies": {
		"cors": "2.8.5",
		"decimal.js": "10.6.0",
		"express": "5.1.0",
		"fs-extra": "11.3.1",
		"http-status-codes": "2.3.0",
		"jszip": "3.10.1"
	},
	"devDependencies": {
		"@tsconfig/node24": "24.0.1",
		"@types/chai": "4.3.0",
		"@types/chai-as-promised": "7.1.4",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.3",
		"@types/fs-extra": "11.0.4",
		"@types/mocha": "10.0.10",
		"@types/node": "24.3.0",
		"@types/supertest": "6.0.3",
		"chai": "4.3.4",
		"chai-as-promised": "7.1.1",
		"chai-http": "4.4.0",
		"mocha": "11.7.1",
		"nyc": "17.1.0",
		"prettier": "3.6.2",
		"supertest": "7.1.4",
		"ts-node": "10.9.2",
		"typescript": "5.9.2"
	},
	"scripts": {
		"start": "node BackEnd/server.ts",
		"dev": "node BackEnd/server.ts",
		"postinstall": "git config core.hooksPath .githooks",
		"cover": "nyc --reporter text --reporter html yarn run test",
		"build": "npm run typecheck",
		"build:lint": "npm run typecheck && yarn prettier:check && yarn lint:check",
		"typecheck": "tsc --noEmit",
		"test": "node --test BackEndTest/*.test.ts",
		"test:auth": "node --test BackEndTest/auth.test.ts",
		"account:status": "node BackEnd/account-status.ts",
		"lint:check": "eslint src test --ext .ts",
		"lint:fix": "eslint src test --ext .ts --fix",
		"prettier:check": "prettier src/**/*.ts test/**/*.ts --check",
		"prettier:fix": "prettier src/**/*.ts test/**/*.ts --write"
	}
}
