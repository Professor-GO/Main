{
  "name": "professor-go",
  "description": "Professor-Go: a hackathon game for recruiting and battling university professors",
  "homepage": "https://github.com/Professor-GO/Main",
  "author": "Reid Holmes",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">= 24 < 25"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "cors": "2.8.5",
    "decimal.js": "10.6.0",
    "express": "5.1.0",
    "fs-extra": "11.3.1",
    "http-status-codes": "2.3.0",
    "jszip": "3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tsconfig/node24": "24.0.1",
    "@types/chai": "4.3.0",
    "@types/chai-as-promised": "7.1.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/fs-extra": "11.0.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "chai": "4.3.4",
    "chai-as-promised": "7.1.1",
    "chai-http": "4.4.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "mocha": "11.7.1",
    "nyc": "17.1.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "scripts": {
    "start": "node src/server/bootstrap/server.ts",
    "dev": "node src/server/bootstrap/server.ts",
    "postinstall": "git config core.hooksPath .githooks",
    "cover": "nyc --reporter text --reporter html yarn run test",
    "build": "npm run typecheck",
    "build:lint": "npm run typecheck && yarn prettier:check && yarn lint:check",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "test:client": "node --test \"src/client/**/*.test.ts\" && vitest run",
    "build:client": "vite build",
    "test": "node --test \"src/server/**/*.test.ts\"",
    "test:auth": "node --test src/server/tests/auth.test.ts",
    "account:status": "node src/server/modules/accounts/infrastructure/accountStatus.ts",
    "lint:check": "eslint src/server src/client *.config.ts",
    "lint:fix": "eslint src/server src/client *.config.ts --fix",
    "prettier:check": "prettier \"src/server/**/*.ts\" \"FrontEnd/**/*.{js,css,html}\" \"*.{json,mjs}\" --check",
    "prettier:fix": "prettier \"src/server/**/*.ts\" \"FrontEnd/**/*.{js,css,html}\" \"*.{json,mjs}\" --write"
  }
}
